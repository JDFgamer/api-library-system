# Environment
NODE_ENV=development

# Server
PORT=3000

# MongoDB - use MONGODB_URI for full connection string or individual vars
MONGODB_URI="mongodb+srv://your_db_user:your_db_password@cluster0.mongodb.net/library_system?retryWrites=true&w=majority"
# Alternatively, use individual components:
# MONGODB_USERNAME="your_db_user"
# MONGODB_PASSWORD="your_db_password"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Bcrypt
BCRYPT_ROUNDS=12

# Frontend URLs (CORS)
FRONTEND_POS_URL="http://localhost:5173"
FRONTEND_ADMIN_URL="http://localhost:5174"
FRONTEND_BOT_URL="http://localhost:5175"

# LLM (OpenAI-compatible — Z.ai GLM-4.7-FlashX de pago. El tier free glm-4.5-flash está DEPRECADO:
# TTFT 8-27s en horas pico y sin soporte. Ver Docs/ai-bot-cost-analysis.md)
AI_LLM_BASE_URL="https://api.z.ai/api/paas/v4/"
AI_LLM_API_KEY=""
AI_LLM_MODEL="glm-4.7-flashx"
AI_LLM_TIMEOUT_MS=60000
AI_MAX_TOOL_CALLS=3

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# MercadoPago (optional)
MERCADOPAGO_ACCESS_TOKEN=""

# Email (optional)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Library System <noreply@librarysystem.com>"