{
  "name": "librarysystem-api",
  "version": "1.0.0",
  "description": "Library System API - Backend for school library POS and Admin",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:dev": "NODE_ENV=development tsx scripts/seed.ts",
    "seed:prod": "NODE_ENV=production tsx scripts/seed.ts",
    "create-superadmin": "tsx scripts/create-superadmin.ts",
    "setup:bot": "tsx scripts/setup-bot.ts",
    "lint": "eslint . --ext .ts",
    "test": "NODE_ENV=test vitest",
    "test:run": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:ui": "NODE_ENV=test vitest --ui"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.8.0",
    "mongoose": "^8.23.0",
    "nodemailer": "^6.9.13",
    "openai": "^7.10.0",
    "typescript": "^5.7.3",
    "winston": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
